# Solzen Frontend Environment Configuration

# Option A: Custom Backend (Gmail + Nodemailer)
# In local dev: http://localhost:5000 (auto-detected if blank in dev)
# In production on Vercel: set this to your deployed backend URL (e.g. https://solzen-backend.onrender.com)
VITE_API_URL=http://localhost:5000

# Option B: EmailJS Fallback (Optional)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
